APP_NAME=BIBLIOFACIL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Fortaleza

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/database/database.sqlite  (padrão: database/database.sqlite)

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Regras de negócio
BIBLIOFACIL_PRAZO_EMPRESTIMO_DIAS=14
BIBLIOFACIL_BLOQUEAR_COM_ATRASO=true
BIBLIOFACIL_LIMITE_EMPRESTIMOS=3
